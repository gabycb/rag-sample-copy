# ATLAS-RAG Bot Service Environment Variables
# Copy to .env and fill in values for local development

# Deployment Environment
ENVIRONMENT=development

# Azure Identity (Managed Identity for service-to-service auth)
AZURE_CLIENT_ID=                          # Managed Identity client ID
AZURE_TENANT_ID=                          # Entra ID tenant
AZURE_KEY_VAULT_URL=                      # Key Vault URI

# Azure AI Services
AZURE_AI_PROJECT_ENDPOINT=                # AI Foundry endpoint
AZURE_AI_SERVICES_ENDPOINT=               # Azure AI Services (OpenAI) endpoint
AZURE_SEARCH_ENDPOINT=                    # Azure AI Search endpoint
AZURE_COSMOS_ENDPOINT=                    # Cosmos DB endpoint

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=    # Telemetry (loaded from Key Vault in prod)

# MS Teams Bot Service
MICROSOFT_APP_ID=                         # Bot app registration ID (Entra ID)
MICROSOFT_APP_PASSWORD=                   # Bot app password (loaded from Key Vault in prod)
BOT_SERVICE_ENDPOINT=                     # Bot Service webhook URL (e.g., https://mybot.azurewebsites.net/api/messages)

# Entra ID OBO Flow (User Delegation for SharePoint)
ENTRA_APP_CLIENT_ID=                      # User app registration for OBO flow
ENTRA_APP_CLIENT_SECRET=                  # OBO client secret (loaded from Key Vault in prod)

# SharePoint
SHAREPOINT_SITE_URL=                      # SharePoint site URL for knowledge base queries
