# ATLAS-RAG Bot Service Environment Variables
# Copy to .env and fill in values for local development.

# Run mode: "local" -> in-memory fakes, no Azure/Teams needed (great for dev & tests).
#           "azure" -> real Azure SDK clients.
APP_MODE=local

# Default AI Search strategy: keyword | vector | hybrid | semantic | hybrid_semantic
SEARCH_STRATEGY=hybrid_semantic

# Azure Identity (User-Assigned Managed Identity for service-to-service auth)
AZURE_CLIENT_ID=                          # Managed Identity client ID
AZURE_TENANT_ID=                          # Entra ID tenant
AZURE_KEY_VAULT_URL=                      # Key Vault URI

# Azure AI Services
AZURE_AI_PROJECT_ENDPOINT=                # AI Foundry project endpoint
AZURE_AI_SERVICES_ENDPOINT=               # Azure AI Services (OpenAI) endpoint
AZURE_SEARCH_ENDPOINT=                    # Azure AI Search endpoint
AZURE_SEARCH_INDEX=sharepoint-index       # Index name (see scripts/create_search_index.py)
AZURE_COSMOS_ENDPOINT=                    # Cosmos DB endpoint
AI_AGENT_ID=                              # Azure AI Foundry agent id (created in the portal/SDK)

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=    # Telemetry

# MS Teams Bot Service (User-Assigned MSI auth — NO password to store)
MICROSOFT_APP_ID=                         # = the Managed Identity client ID
MICROSOFT_APP_TYPE=UserAssignedMSI        # MSI-based bot auth
MICROSOFT_APP_TENANT_ID=                  # Entra ID tenant (single-tenant MSI)

# Entra ID OBO Flow (user-delegated Microsoft Graph access for group resolution)
ENTRA_APP_CLIENT_ID=                      # App registration used for the OBO exchange
ENTRA_APP_CLIENT_SECRET=                  # OBO credential (use a federated MI credential in prod)

# Content Safety (Prompt Shields — input guard against prompt injection)
ENABLE_CONTENT_SAFETY=false               # set true to enable the runtime shield
AZURE_CONTENT_SAFETY_ENDPOINT=            # https://<resource>.cognitiveservices.azure.com

# SharePoint
SHAREPOINT_SITE_URL=                      # SharePoint site URL for knowledge base queries
